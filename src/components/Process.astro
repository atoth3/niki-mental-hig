---
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site } = getContent(lang);
---
<section id="process" class="section">
  <div class="container-x">
    <h2 class="h2">{site.process.title}</h2>
    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {site.process.steps.map((s, i) => (
        <li>
          <div class="grid h-12 w-12 place-items-center rounded-full bg-accent font-display text-xl text-white">{i + 1}</div>
          <h3 class="mt-5 font-display text-xl font-medium">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
