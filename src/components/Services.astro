---
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site } = getContent(lang);
---
<section id="services" class="section bg-white">
  <div class="container-x">
    <h2 class="h2">{site.services.title}</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">{site.services.intro}</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {site.services.items.map((s) => (
        <div class="rounded-3xl bg-cream-50 p-8">
          <h3 class="font-display text-2xl font-medium">{s.title}</h3>
          <p class="mt-3 text-muted">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
